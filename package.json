{
  "name": "movie-night-inventory",
  "version": "1.0.0",
  "description": "Movie Night Budget and Inventory Tracker",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "oxlint src",
    "test": "node --experimental-vm-modules --no-warnings --test tests/*.test.js",
    "test:emulator": "firebase emulators:exec --only firestore --project demo-movie-tenants \"node --experimental-vm-modules --no-warnings --test tests/emulator/*.test.js\"",
    "migrate:tenant": "node scripts/migrate-tenant.js",
    "test:browser": "firebase emulators:exec --only auth,firestore --project demo-movie-tenants \"node tests/browser/tenancy.mjs\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.4",
    "@sveltejs/vite-plugin-svelte": "^3.0.1",
    "firebase-admin": "^13.10.0",
    "firebase-tools": "^14.27.0",
    "oxlint": "^0.12.0",
    "playwright": "^1.65.0",
    "svelte": "^4.2.8",
    "vite": "^5.0.11"
  },
  "dependencies": {
    "firebase": "^10.7.2"
  }
}
