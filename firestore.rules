rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function administrator() {
      return signedIn() && exists(/databases/$(database)/documents/platformAdmins/$(request.auth.uid));
    }
    function canAccess(tenantId) {
      return administrator() || (signedIn() && request.auth.uid in
        get(/databases/$(database)/documents/tenants/$(tenantId)).data.memberUids);
    }
    match /platformAdmins/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
    }
    match /tenants/{tenantId} {
      allow read: if administrator() || (signedIn() && request.auth.uid in resource.data.memberUids);
      // Metadata and access grants are provisioned through the operator script.
      match /events/{document=**} {
        allow read, write: if canAccess(tenantId);
      }
      match /expenses/{document=**} {
        allow read, write: if canAccess(tenantId);
      }
      match /inventory/{document=**} {
        allow read, write: if canAccess(tenantId);
      }
    }
    // Legacy shared roots and UID-based paths are denied by default.
  }
}
